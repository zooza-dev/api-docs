{
  "name": "zooza-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "node scripts/check-api-wording.js && node scripts/check-tool-catalogue.js && node scripts/build-llms-full.js && docusaurus build --out-dir dist",
    "swizzle": "docusaurus swizzle",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "api:generate": "node scripts/generate-api-doc.js",
    "api:check": "node scripts/generate-api-doc.js --check",
    "api:update-subset": "node scripts/update-subset.js",
    "api:update-examples": "node scripts/update-examples.js",
    "api:tag": "node scripts/tag-api-doc.js",
    "api:check-wording": "node scripts/check-api-wording.js",
    "api:check-tools": "node scripts/check-tool-catalogue.js --print"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.1",
    "@docusaurus/plugin-client-redirects": "^3.10.1",
    "@docusaurus/preset-classic": "^3.10.1",
    "@docusaurus/theme-mermaid": "^3.10.1",
    "@scalar/docusaurus": "0.8.55",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.1",
    "@docusaurus/types": "^3.10.1",
    "ajv": "8.20.0",
    "ajv-formats": "2.1.1",
    "js-yaml": "4.1.1"
  },
  "engines": {
    "node": ">=18.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
