{
    "security": [
        {
            "bearerAuth": []
        }
    ],
    "paths": {
        "/token": {
            "post": {
                "operationId": "post_token",
                "tags": [
                    "Authentication"
                ],
                "summary": "Get an access token",
                "description": "OAuth 2.0 client-credentials grant. Send the body as JSON or form-encoded; `client_id` and `client_secret` may also come as HTTP Basic authentication, but `email` is always in the body.\n\n`email` is the email of a user with the owner role in the key's company. The token acts as that owner, and a key can never do more than its owner may. Any current owner can be named. If that user stops being an owner, calls made with the token stop working.\n\nThe token lasts 60 minutes. There is no refresh token: cache the token, reuse it, and request a new one when it expires.\n\nA refused exchange never says why. An unknown key, a wrong secret, a revoked key, an email that is not an owner of the key's company and a locked key all answer `401 invalid_client`. After 10 wrong secrets a key is locked for 5 minutes.\n\nThis operation has its own limit: 5 tokens per key and 20 per IP address per minute.",
                "security": [],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/TokenRequest"
                            }
                        },
                        "application/x-www-form-urlencoded": {
                            "schema": {
                                "$ref": "#/components/schemas/TokenRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Success.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TokenResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "A field is missing (`invalid_request`) or `grant_type` is not `client_credentials` (`unsupported_grant_type`).",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/OAuthError"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "The credentials were not accepted (`invalid_client`). No reason is given.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/OAuthError"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many token requests. Wait for `Retry-After` seconds.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        },
                        "headers": {
                            "Retry-After": {
                                "$ref": "#/components/headers/Retry-After"
                            }
                        }
                    },
                    "503": {
                        "description": "The credentials could not be checked right now. This is not a credential problem; retry later.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/me": {
            "get": {
                "operationId": "get_me",
                "tags": [
                    "Authentication"
                ],
                "summary": "Get key details and budget",
                "description": "The key's access groups and rate tier, the points left in the current minute and day, when the token expires, and every operation the key may call with its cost. Costs no points.",
                "responses": {
                    "200": {
                        "description": "Success.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Me"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "The access token is missing, invalid or expired. Request a new one from `POST /v3/token`.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Error"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Error": {
                "description": "The body of a `401`, `403`, `404`, `422`, `429`, `503` or `504`.",
                "type": "object",
                "required": [
                    "error",
                    "message",
                    "request_id"
                ],
                "properties": {
                    "error": {
                        "description": "A stable machine code, e.g. `validation_failed` or `rate_limited`.",
                        "type": "string"
                    },
                    "message": {
                        "description": "A human-readable explanation, in English.",
                        "type": "string"
                    },
                    "request_id": {
                        "description": "Identifies the request. Also returned as the `X-Request-Id` header; quote it when you contact support.",
                        "type": "string"
                    },
                    "errors": {
                        "description": "On `422` only: every problem found, not only the first (up to 100).",
                        "type": "array",
                        "items": {
                            "type": "object",
                            "required": [
                                "location",
                                "path",
                                "code",
                                "message"
                            ],
                            "properties": {
                                "location": {
                                    "description": "Where the problem is: the body, the query string or the path.",
                                    "type": "string",
                                    "enum": [
                                        "body",
                                        "query",
                                        "path"
                                    ]
                                },
                                "path": {
                                    "description": "A JSON Pointer into the body (e.g. `/participants/0/email`), or the name of the query or path parameter.",
                                    "type": "string"
                                },
                                "code": {
                                    "description": "What is wrong, as a stable machine code.",
                                    "type": "string",
                                    "enum": [
                                        "required_missing",
                                        "type_invalid",
                                        "enum_invalid",
                                        "format_invalid",
                                        "pattern_mismatch",
                                        "minimum",
                                        "maximum",
                                        "min_length",
                                        "max_length",
                                        "min_items",
                                        "max_items",
                                        "unknown_field",
                                        "invalid"
                                    ]
                                },
                                "message": {
                                    "description": "The problem in words, in English.",
                                    "type": "string"
                                },
                                "expected": {
                                    "description": "The rule that was broken, e.g. `{\"maximum\": 200}`.",
                                    "type": "object"
                                },
                                "received": {
                                    "description": "What was sent: its type and, except for secret-looking fields, its value (truncated to 100 characters).",
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            },
            "OAuthError": {
                "description": "The body of a refused `POST /v3/token` (RFC 6749 §5.2).",
                "type": "object",
                "required": [
                    "error"
                ],
                "properties": {
                    "error": {
                        "description": "`invalid_request`: a field is missing. `unsupported_grant_type`: `grant_type` is not `client_credentials`. `invalid_client`: the credentials were not accepted (no reason is given).",
                        "type": "string",
                        "enum": [
                            "invalid_request",
                            "unsupported_grant_type",
                            "invalid_client"
                        ]
                    },
                    "error_description": {
                        "description": "A short explanation, in English.",
                        "type": "string"
                    }
                }
            },
            "TokenRequest": {
                "description": "The credentials to exchange for an access token.",
                "type": "object",
                "required": [
                    "client_id",
                    "client_secret",
                    "email"
                ],
                "properties": {
                    "grant_type": {
                        "description": "Optional. The only accepted value is `client_credentials`.",
                        "type": "string",
                        "enum": [
                            "client_credentials"
                        ]
                    },
                    "client_id": {
                        "description": "The key's client id, e.g. `zk_4768b32989b7303eac7ff30e`.",
                        "type": "string"
                    },
                    "client_secret": {
                        "description": "The key's secret, shown once when the key was created or its secret rotated. Read it from your environment; never put it in code.",
                        "type": "string"
                    },
                    "email": {
                        "description": "The email of an owner of the key's company. The token acts as that owner.",
                        "type": "string",
                        "format": "email"
                    }
                }
            },
            "TokenResponse": {
                "description": "An access token.",
                "type": "object",
                "required": [
                    "access_token",
                    "token_type",
                    "expires_in",
                    "scope"
                ],
                "properties": {
                    "access_token": {
                        "description": "Send it as `Authorization: Bearer <access_token>`.",
                        "type": "string"
                    },
                    "token_type": {
                        "description": "Always `Bearer`.",
                        "type": "string",
                        "enum": [
                            "Bearer"
                        ]
                    },
                    "expires_in": {
                        "description": "Seconds until the token expires.",
                        "type": "integer"
                    },
                    "scope": {
                        "description": "The key's access groups, space-separated, e.g. `core_read core_write`.",
                        "type": "string"
                    }
                }
            },
            "Me": {
                "description": "What the key may do and how much of its company's point budget is left.",
                "type": "object",
                "properties": {
                    "client_id": {
                        "description": "The key's client id.",
                        "type": "string"
                    },
                    "region": {
                        "description": "The region the key belongs to.",
                        "type": "string",
                        "enum": [
                            "EU",
                            "UK",
                            "ASIA"
                        ]
                    },
                    "groups": {
                        "description": "The key's access groups.",
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "tier": {
                        "description": "The company's rate tier, the same for all its keys.",
                        "type": "string"
                    },
                    "points": {
                        "description": "The company's point budget, shared by all its keys.",
                        "type": "object",
                        "properties": {
                            "limit_minute": {
                                "description": "Points per minute.",
                                "type": "integer"
                            },
                            "remaining_minute": {
                                "description": "Points left in the current minute.",
                                "type": "integer"
                            },
                            "limit_day": {
                                "description": "Points per day (UTC).",
                                "type": "integer"
                            },
                            "remaining_day": {
                                "description": "Points left today.",
                                "type": "integer"
                            },
                            "reset_day": {
                                "description": "When the daily budget resets (midnight UTC).",
                                "type": "string",
                                "format": "date-time"
                            }
                        }
                    },
                    "token": {
                        "description": "The token this request was made with.",
                        "type": "object",
                        "properties": {
                            "expires_at": {
                                "description": "When the token expires.",
                                "type": "string",
                                "format": "date-time"
                            }
                        }
                    },
                    "operations": {
                        "description": "Every operation this key may call.",
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "op": {
                                    "description": "The operation id, as in this reference.",
                                    "type": "string"
                                },
                                "method": {
                                    "description": "The HTTP method.",
                                    "type": "string"
                                },
                                "path": {
                                    "description": "The path, with placeholders such as `{ID}`.",
                                    "type": "string"
                                },
                                "cost": {
                                    "description": "Points the call costs.",
                                    "type": "integer"
                                }
                            }
                        }
                    }
                }
            }
        },
        "responses": {
            "Status401": {
                "description": "The access token is missing, invalid or expired. Request a new one from `POST /v3/token`.",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        }
                    }
                }
            },
            "Status403": {
                "description": "This operation is outside the key's access groups. `GET /v3/me` lists everything the key may call.",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        }
                    }
                }
            },
            "Status422": {
                "description": "The request does not match this operation's schema. `errors` lists every problem found.",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        }
                    }
                }
            },
            "Status429": {
                "description": "Over the company's point budget (shared by all its keys). Wait for `Retry-After` seconds.",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        }
                    }
                },
                "headers": {
                    "Retry-After": {
                        "$ref": "#/components/headers/Retry-After"
                    },
                    "X-RateLimit-Limit": {
                        "$ref": "#/components/headers/X-RateLimit-Limit"
                    },
                    "X-RateLimit-Remaining": {
                        "$ref": "#/components/headers/X-RateLimit-Remaining"
                    },
                    "X-RateLimit-Reset": {
                        "$ref": "#/components/headers/X-RateLimit-Reset"
                    },
                    "X-RateLimit-Limit-Day": {
                        "$ref": "#/components/headers/X-RateLimit-Limit-Day"
                    },
                    "X-RateLimit-Remaining-Day": {
                        "$ref": "#/components/headers/X-RateLimit-Remaining-Day"
                    },
                    "X-RateLimit-Reset-Day": {
                        "$ref": "#/components/headers/X-RateLimit-Reset-Day"
                    }
                }
            },
            "Status503": {
                "description": "The API is temporarily unavailable. No points were charged; retry later.",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        }
                    }
                }
            },
            "Status504": {
                "description": "The API did not answer in time. No points were charged; retry later.",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        }
                    }
                }
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "scheme": "bearer",
                "bearerFormat": "JWT",
                "description": "The `access_token` returned by `POST /v3/token`."
            }
        },
        "headers": {
            "X-RateLimit-Limit": {
                "description": "Points per minute for this key.",
                "schema": {
                    "type": "integer"
                }
            },
            "X-RateLimit-Remaining": {
                "description": "Points left in the current minute.",
                "schema": {
                    "type": "integer"
                }
            },
            "X-RateLimit-Reset": {
                "description": "Seconds until the minute budget resets.",
                "schema": {
                    "type": "integer"
                }
            },
            "X-RateLimit-Limit-Day": {
                "description": "Points per day for this key.",
                "schema": {
                    "type": "integer"
                }
            },
            "X-RateLimit-Remaining-Day": {
                "description": "Points left today (UTC).",
                "schema": {
                    "type": "integer"
                }
            },
            "X-RateLimit-Reset-Day": {
                "description": "Seconds until the daily budget resets.",
                "schema": {
                    "type": "integer"
                }
            },
            "Retry-After": {
                "description": "Seconds to wait before trying again.",
                "schema": {
                    "type": "integer"
                }
            }
        }
    }
}
